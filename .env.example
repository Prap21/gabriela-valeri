# Copy this file to .env and use Stripe test-mode keys while developing.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Public URL where the React app is available (the local development default).
APP_URL=http://localhost:3000
API_PORT=4242

# Enter the real shipping price in euro cents. Use 0 only for explicitly free shipping.
SHIPPING_AMOUNT_CENTS=0
SHIPPING_DISPLAY_NAME=Shipping
ALLOWED_SHIPPING_COUNTRIES=GR

# Set to true only after Stripe Tax is configured for the business.
STRIPE_AUTOMATIC_TAX=false
